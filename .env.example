# Required when MOCK_AI=false. CALCTUTOR_ANTHROPIC_API_KEY is preferred;
# ANTHROPIC_API_KEY is the fallback.
CALCTUTOR_ANTHROPIC_API_KEY=

ANTHROPIC_MODEL_SOLVE=claude-sonnet-5-5
ANTHROPIC_MODEL_TRANSCRIBE=claude-sonnet-5-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

AI_STREAMING=true
MOCK_AI=true
LOG_PROBLEMS=false

DAILY_TOKEN_BUDGET=2000000
RATE_LIMIT_SOLVES_PER_HOUR=30
RATE_LIMIT_TRANSCRIBES_PER_HOUR=30
